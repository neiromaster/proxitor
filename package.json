{
  "name": "proxitor",
  "version": "0.9.0-beta.11",
  "type": "module",
  "description": "Lightweight proxy for routing CLI requests (claude-code, codex) to OpenRouter",
  "bin": "./dist/cli.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.mjs",
    "start:dev": "pnpm run build && pnpm run start",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --fix ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check:biome": "biome check ./src",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --reporter verbose tests/integration/",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run typecheck:all && npm run check:biome && npm run test",
    "prepublishOnly": "npm run build",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "proxy",
    "openrouter",
    "cli",
    "claude-code",
    "codex",
    "ai",
    "llm"
  ],
  "packageManager": "pnpm@11.5.1",
  "author": "neiromaster",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neiromaster/proxitor.git"
  },
  "bugs": {
    "url": "https://github.com/neiromaster/proxitor/issues"
  },
  "homepage": "https://github.com/neiromaster/proxitor#readme",
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@hono/node-server": "^2.0.4",
    "cmd-ts": "^0.15.0",
    "conf": "^15.1.0",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "js-yaml": "^4.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "lefthook": "^2.1.9",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
