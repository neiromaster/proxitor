{
  "name": "proxitor",
  "version": "0.100.0-beta.0",
  "description": "Multi-provider LLM gateway with a plugin pipeline: Anthropic Messages and OpenAI Chat in, any provider out",
  "keywords": [
    "proxy",
    "llm",
    "gateway",
    "anthropic",
    "openai",
    "claude-code",
    "plugin",
    "ai"
  ],
  "homepage": "https://github.com/neiromaster/proxitor#readme",
  "bugs": {
    "url": "https://github.com/neiromaster/proxitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neiromaster/proxitor.git"
  },
  "license": "MIT",
  "author": "neiromaster",
  "type": "module",
  "bin": {
    "proxitor": "packages/proxy-core/dist/cli.mjs"
  },
  "files": [
    "packages/proxy-core/dist"
  ],
  "scripts": {
    "bench": "pnpm -r --if-present run bench",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run typecheck:all && pnpm run check:biome && pnpm run test",
    "check:biome": "biome check ./packages",
    "format": "biome format --write ./packages",
    "format:check": "biome format ./packages",
    "lint": "biome lint ./packages",
    "lint:arch": "depcruise packages --config .dependency-cruiser.mjs",
    "lint:fix": "biome lint --fix ./packages",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish",
    "start": "node packages/proxy-core/dist/cli.mjs",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:all": "pnpm run build && pnpm -r --if-present run typecheck",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@hono/node-server": "^2.0.4",
    "cmd-ts": "^0.15.0",
    "consola": "^3.4.2",
    "hono": "^4.13.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.0.1",
    "dependency-cruiser": "^18.2.0",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
